# Kültür Tekno — ortam değişkenleri örneği
# Dokploy panelinde veya .env dosyasında bu değerleri doldurun.
# (.env dosyası git'e GÖNDERİLMEZ — yalnızca bu örnek paylaşılır.)

# PostgreSQL
PGUSER=postgres
PGPASSWORD=guclu-bir-sifre-girin
PGDATABASE=citynews
# docker-compose içinde veritabanı servis adı "db" olmalıdır:
PGHOST=db
PGPORT=5432

# API / uygulama portu
PORT=4000
NODE_ENV=production
