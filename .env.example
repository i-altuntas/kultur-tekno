# Kültür Tekno — ortam değişkenleri örneği
# Dokploy panelinde veya .env dosyasında bu değerleri doldurun.
# (.env dosyası git'e GÖNDERİLMEZ — yalnızca bu örnek paylaşılır.)

# PostgreSQL
PGUSER=postgres
PGPASSWORD=guclu-bir-sifre-girin
PGDATABASE=citynews
# docker-compose içinde veritabanı servis adı "db" olmalıdır:
PGHOST=db
PGPORT=5432

# API / uygulama portu
PORT=4000
NODE_ENV=production

# ───────────── PANEL GÜVENLİĞİ ─────────────
# Yönetici e-postası ve parolası kodda veya .env dosyalarında TUTULMAZ;
# yalnızca veritabanında (admin_users tablosunda, bcrypt cost-12 özeti olarak) saklanır.
# İlk yöneticiyi oluşturmak veya sıfırlamak için:
#   cd server && npm run set-admin

# Oturum ayarları
SESSION_HOURS=8          # hareketsizlik ömrü (aktif kullanımda ileri kayar)
MAX_SESSION_HOURS=24     # mutlak oturum ömrü (bu süreden sonra yeniden giriş zorunludur)
MAX_FAILED_LOGINS=5      # bu kadar hatalı denemeden sonra hesap kilitlenir
LOCK_MINUTES=15          # kilit süresi (dakika)

# Çerezli isteklere izin verilen kökenler (virgülle ayrılır).
# Üretimde MUTLAKA kendi alan adınızı yazın — boş bırakılırsa yalnızca
# aynı köken ve localhost kabul edilir.
ALLOWED_ORIGINS=https://alanadiniz.com
